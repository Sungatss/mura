{
  "name": "mura-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "npm run validate:data && npm run validate:i18n && npm run validate:learning",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "validate:learning": "node scripts/validate-learning.mjs",
    "test:learning": "node tests/learning.test.mjs",
    "test:guide": "tsc src/lib/guide/validation.ts --module commonjs --target es2022 --skipLibCheck --outDir .next/guide-test && node tests/guide-validation.test.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.15.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  }
}
